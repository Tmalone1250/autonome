# BOT Chain Autonome Core Environment Configuration Template

# Private Keys (NEVER COMMIT ACTUAL PRIVATE KEYS TO GIT)
NODE_PRIVATE_KEY=0x_YOUR_NODE_PRIVATE_KEY_HERE
DEPLOYER_PRIVATE_KEY=0x_YOUR_DEPLOYER_PRIVATE_KEY_HERE
RELAYER_PRIVATE_KEY=0x_YOUR_RELAYER_PRIVATE_KEY_HERE

# Service Hosts & RPC
OLLAMA_HOST=http://127.0.0.1:11434
RPC_URL=https://rpc.bohr.life
CHAIN_ID=968

# Orchestrator endpoint — used by the Worker Node to establish its WebSocket connection.
# Set to the public IP/hostname of your Hetzner VPS (or http://127.0.0.1:8002 for local dev).
ORCHESTRATOR_URL=http://2.28.235.223:8002
